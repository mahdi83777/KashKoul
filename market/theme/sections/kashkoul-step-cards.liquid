{%- comment -%}
  Three numbered step cards with icons, for the help pages (How to order: order · WhatsApp · pay;
  Returns: photo · check · exchange).
  Text comes from kashkoul.pages.<page>.step_N_title / step_N_text in the visitor's language.
{%- endcomment -%}
{%- liquid
  assign base = 'kashkoul.pages.' | append: section.settings.page | append: '.'
  assign hours = settings.kashkoul_return_hours | default: 48
-%}
<section class="kk-stepcards">
  <div class="kk-wrap">
    {%- assign key = base | append: 'steps_title' -%}
    <h2 class="kk-title kk-stepcards__title">{{ key | t }}</h2>
    <ol class="kk-stepcards__list">
      {%- for i in (1..3) -%}
        {%- liquid
          assign title_key = base | append: 'step_' | append: i | append: '_title'
          assign text_key = base | append: 'step_' | append: i | append: '_text'
        -%}
        <li class="kk-stepcard">
          <span class="kk-stepcard__top">
            <span class="kk-stepcard__icon" aria-hidden="true">
              {%- if section.settings.page == 'returns' -%}
                {%- case i -%}
                  {%- when 1 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                  {%- when 2 -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 9a8 8 0 0 1 14-3l2 2M20 15a8 8 0 0 1-14 3l-2-2"/><path d="M20 4v4h-4M4 20v-4h4"/></svg>
                {%- endcase -%}
              {%- else -%}
              {%- case i -%}
                {%- when 1 -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                {%- when 2 -%}
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M6.5 9.5v.01M17.5 14.5v.01"/></svg>
              {%- endcase -%}
              {%- endif -%}
            </span>
            <span class="kk-stepcard__num" aria-hidden="true">{{ i }}</span>
          </span>
          <h3 class="kk-stepcard__title">{{ title_key | t }}</h3>
          <p class="kk-stepcard__text">{{ text_key | t: hours: hours }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Kashkoul step cards",
  "tag": "div",
  "class": "kk-stepcards-section",
  "settings": [
    {
      "type": "select",
      "id": "page",
      "label": "Text",
      "options": [
        { "value": "how_to_order", "label": "How to order" },
        { "value": "returns", "label": "Returns" }
      ],
      "default": "how_to_order"
    }
  ],
  "presets": [{ "name": "Kashkoul step cards" }]
}
{% endschema %}
