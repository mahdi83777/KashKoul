{%- comment -%}
  About: one big statement, then three fact cards with icons (from the US · delivered anywhere · pay on arrival).
  Text in the visitor's language (market/strings.json → kashkoul.about); the fee from Theme settings → Kashkoul.
{%- endcomment -%}
{%- assign fee = settings.kashkoul_delivery_fee | default: 5 -%}
<section class="kk-about">
  <div class="kk-wrap">
    <p class="kk-about__statement">{{ 'kashkoul.about.statement' | t }}</p>
    <ul class="kk-cards3">
      {%- for i in (1..3) -%}
        {%- liquid
          assign title_key = 'kashkoul.about.fact_' | append: i | append: '_title'
          assign text_key = 'kashkoul.about.fact_' | append: i | append: '_text'
        -%}
        <li class="kk-stepcard">
          <span class="kk-stepcard__icon" aria-hidden="true">
            {%- case i -%}
              {%- when 1 -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
              {%- when 2 -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="12" cy="12" r="3"/></svg>
            {%- endcase -%}
          </span>
          <h3 class="kk-stepcard__title">{{ title_key | t }}</h3>
          <p class="kk-stepcard__text">{{ text_key | t: fee: fee }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Kashkoul about",
  "tag": "div",
  "class": "kk-about-section",
  "settings": [
    { "type": "paragraph", "content": "Text in English and Arabic from the theme; the delivery fee from Theme settings → Kashkoul." }
  ],
  "presets": [{ "name": "Kashkoul about" }]
}
{% endschema %}
