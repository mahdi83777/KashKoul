{%- comment -%}
  FAQ: questions grouped by topic, each answer opens with a tap (<details>, no script needed).
  Questions and answers come from market/strings.json → kashkoul.faq, in the visitor's language; numbers from
  Theme settings → Kashkoul.
{%- endcomment -%}
{%- liquid
  assign fee = settings.kashkoul_delivery_fee | default: 5
  assign over = settings.kashkoul_deposit_over | default: 100
  assign deposit = settings.kashkoul_deposit_percent | default: 30
  assign discount = settings.kashkoul_discount_percent | default: 10
  assign hours = settings.kashkoul_return_hours | default: 48
  # Left-to-right isolates (U+2066 … U+2069) keep ranges like 3–5 from flipping to 3–1 in Arabic.
  assign days = settings.kashkoul_days_in_stock | default: '3–5' | prepend: '⁦' | append: '⁩'
  assign weeks = settings.kashkoul_weeks_on_order | default: '2–4' | prepend: '⁦' | append: '⁩'
  assign groups = 'ordering:card,source,deposit,discount|delivery:time,where|returns:return,warranty|requests:request' | split: '|'
-%}
<section class="kk-faq">
  <div class="kk-wrap kk-faq__in">
    {%- for group in groups -%}
      {%- liquid
        assign parts = group | split: ':'
        assign group_key = 'kashkoul.faq.' | append: parts[0]
        assign items = parts[1] | split: ','
      -%}
      <div class="kk-faq__group">
        <h2 class="kk-faq__heading">{{ group_key | t }}</h2>
        <div class="kk-faq__list">
          {%- for item in items -%}
            {%- liquid
              assign q_key = 'kashkoul.faq.' | append: item | append: '_q'
              assign a_key = 'kashkoul.faq.' | append: item | append: '_a'
              case item
                when 'deposit'
                  assign answer = a_key | t: over: over, percent: deposit
                when 'discount'
                  assign answer = a_key | t: percent: discount
                when 'time'
                  assign answer = a_key | t: days: days, weeks: weeks
                when 'where'
                  assign answer = a_key | t: fee: fee
                when 'return', 'warranty'
                  assign answer = a_key | t: hours: hours
                else
                  assign answer = a_key | t
              endcase
            -%}
            <details class="kk-faq__item">
              <summary class="kk-faq__q">
                <span>{{ q_key | t }}</span>
                <span class="kk-faq__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg></span>
              </summary>
              <p class="kk-faq__a">{{ answer }}</p>
            </details>
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Kashkoul FAQ",
  "tag": "div",
  "class": "kk-faq-section",
  "settings": [
    { "type": "paragraph", "content": "Questions and answers in English and Arabic from the theme; numbers from Theme settings → Kashkoul." }
  ],
  "presets": [{ "name": "Kashkoul FAQ" }]
}
{% endschema %}
