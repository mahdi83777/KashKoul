{%- comment -%}
  "In stock or on order?": two cards with the delivery time of each, from Theme settings → Kashkoul
  (days for in-stock items, weeks for on-order items). Text in the visitor's language.
{%- endcomment -%}
{%- liquid
  # Wrapped in left-to-right isolates (U+2066 … U+2069) so a range like 1–3 doesn't flip to 3–1 in Arabic.
  assign days = settings.kashkoul_days_in_stock | default: '1–3' | prepend: '⁦' | append: '⁩'
  assign weeks = settings.kashkoul_weeks_on_order | default: '2–4' | prepend: '⁦' | append: '⁩'
-%}
<section class="kk-avail">
  <div class="kk-wrap">
    <div class="kk-heading kk-heading--center kk-avail__head">
      <h2 class="kk-title">{{ 'kashkoul.availability.title' | t }}</h2>
      <p class="kk-avail__intro">{{ 'kashkoul.availability.intro' | t }}</p>
    </div>
    <div class="kk-avail__grid">
      <div class="kk-avail__card kk-avail__card--stock">
        <span class="kk-avail__badge">{{ 'kashkoul.availability.in_stock' | t }}</span>
        <span class="kk-avail__small">{{ 'kashkoul.availability.delivered_in' | t }}</span>
        <span class="kk-avail__time">{{ 'kashkoul.availability.in_stock_time' | t: days: days }}</span>
        <p class="kk-avail__text">{{ 'kashkoul.availability.in_stock_text' | t }}</p>
      </div>
      <div class="kk-avail__card kk-avail__card--order">
        <span class="kk-avail__badge">{{ 'kashkoul.availability.on_order' | t }}</span>
        <span class="kk-avail__small">{{ 'kashkoul.availability.delivered_in' | t }}</span>
        <span class="kk-avail__time">{{ 'kashkoul.availability.on_order_time' | t: weeks: weeks }}</span>
        <p class="kk-avail__text">{{ 'kashkoul.availability.on_order_text' | t }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "In stock or on order",
  "tag": "div",
  "class": "kk-avail-section",
  "settings": [
    { "type": "paragraph", "content": "Delivery times come from Theme settings → Kashkoul. Text in English and Arabic from the theme." }
  ],
  "presets": [{ "name": "In stock or on order" }]
}
{% endschema %}
