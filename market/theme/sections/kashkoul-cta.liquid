{%- comment -%}
  Mustard closing band with a WhatsApp button. Three versions (setting "variant"): request ("Can't find it here?"),
  question ("Still have a question?"), returns ("Something wrong with your order?"). Text in the visitor's language
  (market/strings.json → kashkoul.cta.<variant>); the button opens WhatsApp with a message ready.
{%- endcomment -%}
{%- liquid
  assign v = 'kashkoul.cta.' | append: section.settings.variant | append: '.'
  assign hours = settings.kashkoul_return_hours | default: 48
  assign key = v | append: 'message'
  assign kk_message = key | t
  capture wa_url
    render 'kashkoul-whatsapp-url', message: kk_message
  endcapture
-%}
<section class="kk-cta">
  <div class="kk-wrap kk-cta__in">
    <div class="kk-cta__text">
      {%- assign k_eyebrow = v | append: 'eyebrow' -%}
      {%- assign k_title = v | append: 'title' -%}
      {%- assign k_text = v | append: 'text' -%}
      <p class="kk-label kk-cta__eyebrow">{{ k_eyebrow | t }}</p>
      <h2 class="kk-title">{{ k_title | t }}</h2>
      <p class="kk-cta__body">{{ k_text | t: hours: hours }}</p>
    </div>
    <a class="kk-button kk-cta__button" href="{{ wa_url }}" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
      {%- assign k_button = v | append: 'button' -%}
      {{ k_button | t }}<span class="visually-hidden"> {{ 'kashkoul.new_tab' | t }}</span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Kashkoul WhatsApp band",
  "tag": "div",
  "class": "kk-cta-section",
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Version",
      "options": [
        { "value": "request", "label": "Can't find it here? (send an Amazon link)" },
        { "value": "question", "label": "Still have a question?" },
        { "value": "returns", "label": "Something wrong with your order?" }
      ],
      "default": "request",
      "info": "Text in English and Arabic from the theme. The button opens WhatsApp with a message ready."
    }
  ],
  "presets": [{ "name": "Kashkoul WhatsApp band" }]
}
{% endschema %}
