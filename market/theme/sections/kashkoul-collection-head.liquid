{%- comment -%}
  Shop / category page header: "Shop" label, the category title and description, then the categories as chips for
  one-tap switching. The chips are the links under "Shop" in the main menu (Online Store → Navigation), so the owner
  manages them there; the current category is highlighted.
{%- endcomment -%}
{%- liquid
  assign kk_menu = linklists[section.settings.menu]
  assign kk_links = null
  for link in kk_menu.links
    if link.links.size > 0
      assign kk_links = link.links
      break
    endif
  endfor
  assign kk_title = collection.title | default: page_title
-%}
<div class="kk-wrap">
  <header class="kk-chead">
    <p class="kk-label kk-chead__eyebrow">{{ 'kashkoul.crumbs.shop' | t }}</p>
    <h1 class="kk-chead__title">{{ kk_title | escape }}</h1>
    {%- if collection.description != blank -%}
      <div class="kk-chead__text">{{ collection.description }}</div>
    {%- endif -%}
    {%- if kk_links -%}
      <nav class="kk-chips" aria-label="{{ 'kashkoul.crumbs.categories' | t }}">
        {%- for link in kk_links -%}
          {%- liquid
            assign kk_on = false
            if link.active or link.url == collection.url
              assign kk_on = true
            endif
          -%}
          <a class="kk-chip{% if kk_on %} is-on{% endif %}" href="{{ link.url }}"{% if kk_on %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </header>
</div>

{% schema %}
{
  "name": "Kashkoul shop header",
  "tag": "div",
  "class": "kk-chead-section",
  "settings": [
    { "type": "paragraph", "content": "Category title, description (from the collection) and category chips (the links under \"Shop\" in this menu)." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ],
  "presets": [{ "name": "Kashkoul shop header" }]
}
{% endschema %}
