{%- comment -%}
  Homepage opening, in the help pages' title-band style: label, big title, intro and two buttons on one side, a photo
  toned brick and mustard on the other (hidden on phones, like the pages). Empty text settings show the approved text
  in the visitor's language (market/strings.json → kashkoul.home).
{%- endcomment -%}
{%- liquid
  assign kk_heading = section.settings.heading | escape
  if kk_heading == blank
    assign kk_heading = 'kashkoul.home.headline' | t
  endif
  assign kk_sub = section.settings.subheading | escape
  if kk_sub == blank
    assign kk_sub = 'kashkoul.home.subline' | t
  endif
  assign kk_button = section.settings.button_label | escape
  if kk_button == blank
    assign kk_button = 'kashkoul.home.shop_now' | t
  endif
  assign kk_link = section.settings.button_link | default: routes.all_products_collection_url
  capture kk_order_link
    render 'kashkoul-url', path: '/pages/how-to-order'
  endcapture
  assign kk_alt = section.settings.image.alt
  if kk_alt == blank
    assign kk_alt = 'kashkoul.home.photo_alt' | t
  endif
-%}
<section class="kk-page-hero kk-home-hero">
  <div class="kk-wrap kk-page-hero__in">
    <div class="kk-page-hero__text">
      <p class="kk-label">{{ 'kashkoul.home.eyebrow' | t }}</p>
      <h1 class="kk-title">{{ kk_heading }}</h1>
      <p class="kk-page-hero__intro">{{ kk_sub }}</p>
      {%- if section.settings.show_button -%}
        <div class="kk-buttons">
          <a class="kk-button" href="{{ kk_link }}">{{ kk_button }}</a>
          {%- if section.settings.show_order_button -%}
            <a class="kk-button kk-button--outline" href="{{ kk_order_link }}">{{ 'kashkoul.home.how_to_order' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="kk-page-hero__media kk-duo">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 560px, 1px', loading: 'lazy', alt: kk_alt, style: 'object-position: 50% 45%' }}
      {%- else -%}
        <img src="{{ 'kashkoul-photo-qanun.jpg' | asset_url }}" alt="{{ kk_alt | escape }}" width="1066" height="1600" loading="lazy" style="object-position: 50% 45%">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kashkoul headline",
  "tag": "div",
  "class": "kk-hero-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Leave the text fields empty to show the approved English and Arabic text."
    },
    { "type": "text", "id": "heading", "label": "Headline" },
    { "type": "textarea", "id": "subheading", "label": "Line below the headline" },
    { "type": "checkbox", "id": "show_button", "label": "Show buttons", "default": true },
    { "type": "text", "id": "button_label", "label": "Button text" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty for all products." },
    { "type": "checkbox", "id": "show_order_button", "label": "Show the \"How to order\" button", "default": true },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Toned brick and mustard, hidden on phones. Leave empty for the Kashkoul qanun photo." }
  ],
  "presets": [{ "name": "Kashkoul headline" }]
}
{% endschema %}
