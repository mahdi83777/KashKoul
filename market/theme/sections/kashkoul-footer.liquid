{%- comment -%}
  Footer A, "compact brick" (chosen on the homepage v2 board, 2026-10-15):
  the full Market logo with one line and a WhatsApp button, then Shop / Help / Kashkoul columns, and a thin darker bar
  with © and the Miqvaro credit. Shop lists the categories under "Shop" in the main menu (so a new category shows up
  here by itself), or the menu picked in the editor; Help uses the menu picked in the editor, or the help pages. The Kashkoul column comes from shared/sites.json (snippets/kashkoul-house.liquid,
  kind 'links'). All text in the visitor's language.
{%- endcomment -%}
{%- capture wa_url -%}{% render 'kashkoul-whatsapp-url' %}{%- endcapture -%}
<footer class="kk-ft">
  <div class="kk-wrap kk-ft__top">
    <div class="kk-ft__brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        <img src="{{ 'kashkoul-market-logo-full-mustard.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="303" height="226" loading="lazy">
      </a>
      <p class="kk-ft__tagline">{{ 'kashkoul.footer.tagline' | t }}</p>
      <a class="kk-ft__wa" href="{{ wa_url }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
        {{ 'kashkoul.footer.wa_button' | t }}<span class="visually-hidden"> {{ 'kashkoul.new_tab' | t }}</span>
      </a>
    </div>

    <nav class="kk-ft__col" aria-labelledby="kk-ft-shop">
      <h2 class="kk-ft__head" id="kk-ft-shop">{{ 'kashkoul.footer.shop' | t }}</h2>
      {%- liquid
        assign kk_shop_links = section.settings.shop_menu.links
        if section.settings.shop_menu == blank
          for link in linklists['main-menu'].links
            if link.links.size > 0
              assign kk_shop_links = link.links
              break
            endif
          endfor
        endif
      -%}
      {%- if kk_shop_links.size > 0 -%}
        {%- for link in kk_shop_links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.collections_url }}/instruments">{{ 'kashkoul.categories.instruments' | t }}</a>
        <a href="{{ routes.collections_url }}/strings-accessories">{{ 'kashkoul.categories.strings' | t }}</a>
        <a href="{{ routes.collections_url }}/studio-recording">{{ 'kashkoul.categories.studio' | t }}</a>
        <a href="{{ routes.collections_url }}/art-supplies">{{ 'kashkoul.categories.art' | t }}</a>
        <a href="{{ routes.collections_url }}/books-sheet-music">{{ 'kashkoul.categories.books' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'kashkoul.categories.all' | t }}</a>
      {%- endif -%}
    </nav>

    <nav class="kk-ft__col" aria-labelledby="kk-ft-help">
      <h2 class="kk-ft__head" id="kk-ft-help">{{ 'kashkoul.footer.help' | t }}</h2>
      {%- if section.settings.help_menu != blank -%}
        {%- for link in section.settings.help_menu.links -%}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- assign pages = 'request:request,how-to-order:how_to_order,delivery-pickup:delivery,returns:returns,faq:faq,about:about' | split: ',' -%}
        {%- for p in pages -%}
          {%- assign parts = p | split: ':' -%}
          {%- assign path = '/pages/' | append: parts[0] -%}
          {%- assign label_key = 'kashkoul.footer.' | append: parts[1] -%}
          <a href="{% render 'kashkoul-url', path: path %}">{{ label_key | t }}</a>
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <nav class="kk-ft__col kk-ft__col--house" aria-labelledby="kk-ft-house">
      <h2 class="kk-ft__head" id="kk-ft-house">{{ 'kashkoul.footer.kashkoul' | t }}</h2>
      {% render 'kashkoul-house', kind: 'links' %}
    </nav>
  </div>

  <div class="kk-ft__bar">
    <div class="kk-wrap kk-ft__bar-in">
      <span>© {{ 'now' | date: '%Y' }} {{ 'kashkoul.footer.copyright' | t }}</span>
      <span lang="en" dir="ltr"><a href="https://miqvaro.com" target="_blank" rel="noopener noreferrer">{{ 'kashkoul.footer.credit' | t }} Miqvaro</a></span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Kashkoul footer",
  "tag": "div",
  "class": "kk-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "link_list", "id": "shop_menu", "label": "Shop links", "info": "Leave empty for the categories under \"Shop\" in the main menu." },
    { "type": "link_list", "id": "help_menu", "label": "Help links", "info": "Leave empty for Request a product, How to order, Delivery & pickup, Returns, FAQ and About." },
    { "type": "paragraph", "content": "The Kashkoul column (Academy, Studio) comes from shared/sites.json in the code." }
  ],
  "presets": [{ "name": "Kashkoul footer" }]
}
{% endschema %}
