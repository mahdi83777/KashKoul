{%- comment -%}
  Phones: the "Category" button of the filter bar (next to "Filter & sort", blocks/filters.liquid) and the sheet it
  opens from the bottom of the screen with the categories list (snippets/kashkoul-category-tree.liquid). The bar stays
  pinned at the top while the products scroll; opening, closing and pinning are in assets/kashkoul.js.
{%- endcomment -%}
{%- liquid
  assign kk_has = false
  for link in linklists['main-menu'].links
    if link.links.size > 0
      assign kk_has = true
      break
    endif
  endfor
-%}
{%- if kk_has and collection -%}
  <button type="button" class="kk-csheet-open" data-kk-csheet-open aria-haspopup="dialog" aria-controls="kk-csheet">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>
    <span class="kk-csheet-open__label">
      {%- if collection.handle == 'all' -%}{{ 'kashkoul.shop.all_title' | t }}{%- else -%}{{ collection.title | escape }}{%- endif -%}
    </span>
    <span class="kk-csheet-open__chevron" aria-hidden="true"></span>
  </button>
  <dialog class="kk-csheet" id="kk-csheet" aria-label="{{ 'kashkoul.crumbs.categories' | t }}">
    <div class="kk-csheet__head">
      <p class="kk-csheet__title">{{ 'kashkoul.crumbs.categories' | t }}</p>
      <button type="button" class="kk-csheet__close" data-kk-csheet-close aria-label="{{ 'actions.close' | t }}"></button>
    </div>
    {% render 'kashkoul-category-tree', sheet: true %}
  </dialog>
{%- endif -%}
