{%- comment -%}
  Product page: "Ask about this" (WhatsApp icon), with the product's name and link in the pre-filled message. Rendered
  in the buttons row beside "Buy it now" (blocks/buy-buttons.liquid), or on its own by blocks/kashkoul-whatsapp-ask.

  @param {object} product - The product
{%- endcomment -%}
{%- liquid
    assign kk_url = request.origin | append: product.url
  # joined, not interpolated: t would HTML-escape the title (D'Addario → D&#39;Addario) inside the WhatsApp text
  assign kk_message = 'kashkoul.product.ask_message' | t | append: ' ' | append: product.title | append: ' ' | append: kk_url
  capture wa_url
    render 'kashkoul-whatsapp-url', message: kk_message
  endcapture
-%}
<a class="kk-button kk-button--outline kk-ask" href="{{ wa_url }}" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" width="20" height="20" fill="#1f7a4d" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
  {{ 'kashkoul.product.ask' | t }}<span class="visually-hidden"> {{ 'kashkoul.new_tab' | t }}</span>
</a>
